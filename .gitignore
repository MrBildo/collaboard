# Agent workspace (instance-local)
.agents/

# Claude Code (instance-local)
.claude/*

# Auth keys
.agents.env

# MCP config (user-level)
.mcp.json

# Node
node_modules/
frontend/node_modules/
frontend/dist/
# Throwaway sourcemap build the third-party-notices check reads to learn which
# npm packages actually reach the browser bundle. Deliberately a separate output
# directory from frontend/dist/ so sourcemaps can never leak into wwwroot.
frontend/dist-notices-audit/

# .NET
backend/**/bin/
backend/**/obj/
backend/**/TestResults/
# `dotnet publish` output.
publish/

# Aspire local state
.aspire/

# Collaboard app
backend/Collaboard.Api/wwwroot/
*.db
*.db-shm
*.db-wal
*.db.bak-*
data/

# IDE / editor
.vscode/
.vs/

# Secrets / env
backend/**/Properties/launchSettings.json
!backend/Collaboard.AppHost/Properties/launchSettings.json
backend/**/appsettings.Development.json
# Smart-merge baseline sidecar (#235). Runtime artifact written by the installer
# next to appsettings.json; never in the source tree, never committed.
backend/**/appsettings.shipped.json
appsettings.shipped.json
frontend/.env
frontend/.env.*

# Build info
frontend/tsconfig.tsbuildinfo
frontend/src/**/*.js

# Playwright MCP
.playwright-mcp/

# OS files
Thumbs.db
Desktop.ini
.DS_Store
