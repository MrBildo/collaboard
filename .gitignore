# Agent workspace (instance-local)
.agents/

# Claude Code (instance-local)
.claude/*

# Auth keys
.agents.env

# MCP config (user-level)
.mcp.json

# Node
node_modules/
frontend/node_modules/
# Vite build output. Deliberately a glob rather than a list of known directories.
# Tailwind's content scan is rooted at the Vite root (frontend/) and skips
# whatever git ignores, so ANY unignored build output under frontend/ becomes an
# input to the NEXT build: the scanner finds class-name-shaped strings in a
# previous bundle and emits utilities for them, which changes the stylesheet and
# every chunk hash downstream of it. Two people hit that on this tree in one day,
# each having added a new output directory and remembered only some of the places
# that need to know about it. A glob means naming a throwaway output `dist-...`
# is enough. Mirror any change here in frontend/eslint.config.js, which ignores
# the same set for the same underlying reason.
frontend/dist*/

# .NET
backend/**/bin/
backend/**/obj/
backend/**/TestResults/
# `dotnet publish` output.
publish/
# Bundle sourcemaps moved out of the frontend build so the third-party-notices
# inventory can be read from the same build that ships. Outside frontend/ on
# purpose -- see the note on the Vite output glob above.
notices-sourcemaps/

# Aspire local state
.aspire/

# Collattice app
backend/Collabot.Collattice.Api/wwwroot/
*.db
*.db-shm
*.db-wal
*.db.bak-*
data/

# IDE / editor
.vscode/
.vs/

# Secrets / env
backend/**/Properties/launchSettings.json
!backend/Collabot.Collattice.AppHost/Properties/launchSettings.json
backend/**/appsettings.Development.json
# Smart-merge baseline sidecar (#235). Runtime artifact written by the installer
# next to appsettings.json; never in the source tree, never committed.
backend/**/appsettings.shipped.json
appsettings.shipped.json
frontend/.env
frontend/.env.*

# Build info
frontend/tsconfig.tsbuildinfo
frontend/src/**/*.js

# Playwright MCP
.playwright-mcp/

# OS files
Thumbs.db
Desktop.ini
.DS_Store
